# League App Configuration
VITE_ADMIN_TOKEN=your_admin_token_hash_here

# Fantacalcio API Extraction Credentials 
LEAGUE_ALIAS=your_league_alias_here
APP_KEY=your_app_key_here
BEARER_TOKEN=Bearer your_bearer_token_here
BASE_API=https://apileague.fantacalcio.it/onboarding/v1/hof

# Active In-Progress Competitions (optional, auto-detected from season config if not provided)
COMPETITION_ID=your_campionato_competition_id_here
CUP_COMPETITION_ID=your_cup_competition_id_here
SUPERCUP_COMPETITION_ID=your_supercoppa_competition_id_here
MUNDIALITO_COMPETITION_ID=your_mundialito_competition_id_here
PERDENTI_COMPETITION_ID=your_perdenti_competition_id_here
